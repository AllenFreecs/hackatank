AZURE_DEVOPS_ORG_URL=https://dev.azure.com/RSGNA
AZURE_DEVOPS_DEFAULT_PROJECT=Benefits Insights
AZURE_DEVOPS_TEAM=Benefits Insights
AZURE_DEVOPS_AUTH_TOKEN=replace-with-your-personal-access-token

SHAREPOINT_SITE_URL=https://wtwonline.sharepoint.com/sites/Global
SHAREPOINT_SEARCH_URL=https://wtwonline.sharepoint.com/sites/Global

AZURE_OPENAI_ENDPOINT=https://coreaitest.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Microsoft Graph delegated access token for SharePoint search and the signed-in Teams user's calendar.
# Required Graph permissions: Files.Read.All or Sites.Read.All, Calendars.ReadWrite, OnlineMeetings.ReadWrite (for Teams links).
# Add Mail.Read to use live Outlook messages in the AI Assistant.
MICROSOFT_GRAPH_ACCESS_TOKEN=replace-with-a-microsoft-graph-access-token
MICROSOFT_GRAPH_USER_ID=me
# Optional: use a specific calendar instead of the user's default calendar.
MICROSOFT_GRAPH_CALENDAR_ID=
# Optional: use a specific mail folder instead of Inbox.
MICROSOFT_GRAPH_MAIL_FOLDER_ID=inbox
