{
  "servers": {
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "RSGNA",
        "--authentication",
        "envvar"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ADO_MCP_AUTH_TOKEN": "${env:AZURE_DEVOPS_AUTH_TOKEN}",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "${env:AZURE_DEVOPS_DEFAULT_PROJECT}"
      }
    }
  }
}